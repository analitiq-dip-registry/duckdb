  { "match": "exact", "native": "DECIMAL",   "canonical": "Decimal128(18, 3)" },
  { "match": "exact", "native": "NUMERIC",   "canonical": "Decimal128(18, 3)" },

  { "match": "regex", "native": "^VARCHAR(\\([0-9]+\\))?$", "canonical": "Utf8" },
