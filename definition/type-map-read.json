  { "match": "regex", "native": "^TIMESTAMP(\\([0-9]+\\))? WITH TIME ZONE$", "canonical": "Timestamp(MICROSECOND, UTC)" },
  { "match": "exact", "native": "TIMESTAMPTZ", "canonical": "Timestamp(MICROSECOND, UTC)" },
  { "match": "regex", "native": "^TIMESTAMP(\\([0-9]+\\))?$",                "canonical": "Timestamp(MICROSECOND)" },
  { "match": "exact", "native": "TIMESTAMP_S",  "canonical": "Timestamp(SECOND)" },
