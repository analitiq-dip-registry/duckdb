{
  "$schema": "https://schemas.analitiq.ai/type-map-read/latest.json",
  "direction": "read",
  "rules": [
    {
      "match": "exact",
      "native_type": "BOOLEAN",
      "arrow_type": "Boolean"
    },
    {
      "match": "exact",
      "native_type": "BOOL",
      "arrow_type": "Boolean"
    },
    {
      "match": "exact",
      "native_type": "LOGICAL",
      "arrow_type": "Boolean"
    },
    {
      "match": "exact",
      "native_type": "TINYINT",
      "arrow_type": "Int8"
    },
    {
      "match": "exact",
      "native_type": "INT1",
      "arrow_type": "Int8"
    },
    {
      "match": "exact",
      "native_type": "SMALLINT",
      "arrow_type": "Int16"
    },
    {
      "match": "exact",
      "native_type": "INT2",
      "arrow_type": "Int16"
    },
    {
      "match": "exact",
      "native_type": "SHORT",
      "arrow_type": "Int16"
    },
    {
      "match": "exact",
      "native_type": "INTEGER",
      "arrow_type": "Int32"
    },
    {
      "match": "exact",
      "native_type": "INT4",
      "arrow_type": "Int32"
    },
    {
      "match": "exact",
      "native_type": "INT",
      "arrow_type": "Int32"
    },
    {
      "match": "exact",
      "native_type": "SIGNED",
      "arrow_type": "Int32"
    },
    {
      "match": "exact",
      "native_type": "BIGINT",
      "arrow_type": "Int64"
    },
    {
      "match": "exact",
      "native_type": "INT8",
      "arrow_type": "Int64"
    },
    {
      "match": "exact",
      "native_type": "LONG",
      "arrow_type": "Int64"
    },
    {
      "match": "exact",
      "native_type": "HUGEINT",
      "arrow_type": "Decimal128(38, 0)"
    },
    {
      "match": "exact",
      "native_type": "UTINYINT",
      "arrow_type": "UInt8"
    },
    {
      "match": "exact",
      "native_type": "USMALLINT",
      "arrow_type": "UInt16"
    },
    {
      "match": "exact",
      "native_type": "UINTEGER",
      "arrow_type": "UInt32"
    },
    {
      "match": "exact",
      "native_type": "UBIGINT",
      "arrow_type": "UInt64"
    },
    {
      "match": "exact",
      "native_type": "UHUGEINT",
      "arrow_type": "Decimal128(38, 0)"
    },
    {
      "match": "exact",
      "native_type": "BIGNUM",
      "arrow_type": "Utf8"
    },
    {
      "match": "exact",
      "native_type": "FLOAT",
      "arrow_type": "Float32"
    },
    {
      "match": "exact",
      "native_type": "FLOAT4",
      "arrow_type": "Float32"
    },
    {
      "match": "exact",
      "native_type": "REAL",
      "arrow_type": "Float32"
    },
    {
      "match": "exact",
      "native_type": "DOUBLE",
      "arrow_type": "Float64"
    },
    {
      "match": "exact",
      "native_type": "FLOAT8",
      "arrow_type": "Float64"
    },
    {
      "match": "regex",
      "native_type": "^DECIMAL\\((?<precision>[0-9]+),\\s*(?<scale>[0-9]+)\\)$",
      "arrow_type": "Decimal128(${precision}, ${scale})"
    },
    {
      "match": "regex",
      "native_type": "^NUMERIC\\((?<precision>[0-9]+),\\s*(?<scale>[0-9]+)\\)$",
      "arrow_type": "Decimal128(${precision}, ${scale})"
    },
    {
      "match": "exact",
      "native_type": "DECIMAL",
      "arrow_type": "Decimal128(18, 3)"
    },
    {
      "match": "exact",
      "native_type": "NUMERIC",
      "arrow_type": "Decimal128(18, 3)"
    },
    {
      "match": "regex",
      "native_type": "^VARCHAR(\\([0-9]+\\))?$",
      "arrow_type": "Utf8"
    },
    {
      "match": "regex",
      "native_type": "^CHAR(\\([0-9]+\\))?$",
      "arrow_type": "Utf8"
    },
    {
      "match": "regex",
      "native_type": "^BPCHAR(\\([0-9]+\\))?$",
      "arrow_type": "Utf8"
    },
    {
      "match": "exact",
      "native_type": "TEXT",
      "arrow_type": "Utf8"
    },
    {
      "match": "exact",
      "native_type": "STRING",
      "arrow_type": "Utf8"
    },
    {
      "match": "exact",
      "native_type": "BLOB",
      "arrow_type": "Binary"
    },
    {
      "match": "exact",
      "native_type": "BYTEA",
      "arrow_type": "Binary"
    },
    {
      "match": "exact",
      "native_type": "BINARY",
      "arrow_type": "Binary"
    },
    {
      "match": "exact",
      "native_type": "VARBINARY",
      "arrow_type": "Binary"
    },
    {
      "match": "exact",
      "native_type": "BIT",
      "arrow_type": "Binary"
    },
    {
      "match": "exact",
      "native_type": "BITSTRING",
      "arrow_type": "Binary"
    },
    {
      "match": "exact",
      "native_type": "DATE",
      "arrow_type": "Date32"
    },
    {
      "match": "exact",
      "native_type": "TIME WITH TIME ZONE",
      "arrow_type": "Time64(MICROSECOND)"
    },
    {
      "match": "regex",
      "native_type": "^TIME(\\([0-9]+\\))?$",
      "arrow_type": "Time64(MICROSECOND)"
    },
    {
      "match": "regex",
      "native_type": "^TIMESTAMP(\\([0-9]+\\))? WITH TIME ZONE$",
      "arrow_type": "Timestamp(MICROSECOND, UTC)"
    },
    {
      "match": "exact",
      "native_type": "TIMESTAMPTZ",
      "arrow_type": "Timestamp(MICROSECOND, UTC)"
    },
    {
      "match": "regex",
      "native_type": "^TIMESTAMP(\\([0-9]+\\))?$",
      "arrow_type": "Timestamp(MICROSECOND)"
    },
    {
      "match": "exact",
      "native_type": "TIMESTAMP_S",
      "arrow_type": "Timestamp(SECOND)"
    },
    {
      "match": "exact",
      "native_type": "TIMESTAMP_MS",
      "arrow_type": "Timestamp(MILLISECOND)"
    },
    {
      "match": "exact",
      "native_type": "TIMESTAMP_NS",
      "arrow_type": "Timestamp(NANOSECOND)"
    },
    {
      "match": "exact",
      "native_type": "DATETIME",
      "arrow_type": "Timestamp(MICROSECOND)"
    },
    {
      "match": "exact",
      "native_type": "INTERVAL",
      "arrow_type": "Duration(MICROSECOND)"
    },
    {
      "match": "exact",
      "native_type": "UUID",
      "arrow_type": "Utf8"
    },
    {
      "match": "exact",
      "native_type": "JSON",
      "arrow_type": "Json"
    },
    {
      "match": "regex",
      "native_type": "^STRUCT\\(.*\\)$",
      "arrow_type": "Json"
    },
    {
      "match": "regex",
      "native_type": "^MAP\\(.*\\)$",
      "arrow_type": "Json"
    },
    {
      "match": "regex",
      "native_type": "^UNION\\(.*\\)$",
      "arrow_type": "Json"
    },
    {
      "match": "regex",
      "native_type": "^.+\\[[0-9]*\\]$",
      "arrow_type": "Json"
    },
    {
      "match": "regex",
      "native_type": "^ENUM\\(.*\\)$",
      "arrow_type": "Utf8"
    }
  ]
}
